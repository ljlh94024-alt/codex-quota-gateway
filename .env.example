# Leave empty until the authorized upstream Proxy is installed.
# Shared Docker network: http://<upstream-service>:<container-port>/v1
# Host-published port: http://host.docker.internal:<host-port>/v1
UPSTREAM_BASE_URL=
UPSTREAM_API_KEY=
UPSTREAM_DOCKER_NETWORK=codex-net
MAX_GLOBAL_CONCURRENCY=6
MAX_USER_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_SUSPEND_SECONDS=300
RATE_LIMIT_VIOLATION_THRESHOLD=5
SECRET_SCAN=true
AUDIT_LOG=true
SECURITY_RULES_PATH=/app/security_rules.yaml
ABNORMAL_WINDOW_MINUTES=10
ABNORMAL_REQUESTS_10M=30
ABNORMAL_TOKENS_10M=100000
BACKUP_DIR=/app/data/backup
BACKUP_RETENTION=7
BACKUP_TARGET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
ADMIN_KEY=
SECRET_KEY=replace-with-32-byte-random-secret
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL_SECONDS=28800
SESSION_COOKIE_SECURE=true
DOMAIN=
DUCKDNS_TOKEN=
DUCKDNS_SUBDOMAIN=
SERVER_IP=
PUBLIC_DASHBOARD_MODE=false
PUBLIC_TEST_MODE=false
PUBLIC_PORT=18080
BIND_HOST=0.0.0.0
PUBLIC_DASHBOARD_PASSWORD=
COOKIE_SECURE=true
MAX_RETRIES=3
UPSTREAM_TIMEOUT_SECONDS=600
STREAM_IDLE_TIMEOUT_SECONDS=90
STREAM_MAX_SECONDS=180
QUEUE_TIMEOUT_SECONDS=60
# Estimated shared weekly pool and maximum context used by quota admission.
DEFAULT_TOTAL_QUOTA=1000000000
MAX_CONTEXT_TOKENS=270000
